<Project Sdk="Microsoft.NET.Sdk">

    <!--
      T3：不启动游戏就能跑的 Engine/ 纯函数回归壳（设计文档 §六）。

      刻意【不 Import】Mod.props / Mod.targets：那两个文件会带上游戏程序集引用与 DeployWIP
      （每次构建把部署目录整个删掉重铺）。测试壳绝不能碰部署目录。
      同样刻意【一个 <Reference> 都不填】：壳只编译 Engine\*.cs 这些纯 BCL 文件，
      从结构上保证「被测代码根本不依赖游戏程序集」——哪天有人往 Engine 里加一句
      UnityEngine.Time 或 Colossal.Mathematics，壳会直接编译失败，而不是静默把测试覆盖降级掉。

      与 BLG 的 T3 不同之处：这里用 <Compile Include="..\..\Engine\*.cs" /> 通配拉真源码，
      而不是把源文件抄一份进 tests\ —— 同一份文件同时被模组 csproj 与本壳编译，
      不存在「两份拷贝漂移」这个最大的假绿来源。
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <AssemblyName>ZoneSnapper.T3</AssemblyName>
        <RootNamespace>ZoneSnapper.T3</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Configurations>Debug;Release</Configurations>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
        <Nullable>disable</Nullable>
        <NoWarn>CS0618</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- 本机没装 net48 目标包（无 Visual Studio）：此包只提供编译期参考程序集，
             PrivateAssets=all 保证它不进产物、不产生运行期依赖。 -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="Check.cs" />
        <Compile Include="Harness.cs" />
        <Compile Include="Fixtures.cs" />
        <Compile Include="Tests.Geo.cs" />
        <Compile Include="Tests.Simplify.cs" />
        <Compile Include="Tests.Project.cs" />
        <Compile Include="Tests.Trace.cs" />
        <Compile Include="Tests.Snap.cs" />
        <Compile Include="Tests.Targets.cs" />
        <Compile Include="Tests.Follow.cs" />
        <Compile Include="Tests.Rebind.cs" />
        <Compile Include="Tests.Preview.cs" />
        <Compile Include="Tests.Policy.cs" />
        <Compile Include="Tests.CurveIso.cs" />
        <Compile Include="Tests.Store.cs" />
        <Compile Include="Tests.Heap.cs" />
        <Compile Include="Tests.Locale.cs" />
        <Compile Include="Tests.Junction.cs" />
        <!-- 被测真源码：与模组 csproj 编译的是同一批文件 -->
        <Compile Include="..\..\Engine\*.cs" />
    </ItemGroup>

</Project>
